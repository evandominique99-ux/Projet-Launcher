// Page d'accueil, comme la maquette : un grand cadre ouvert sur le paysage de Misty (le fond de la
// fenêtre), le logo MISTY au milieu et la dernière news dans une petite pastille en bas. Sur
// l'onglet Skin, le studio. Les onglets sont dans la tuile du haut, le lancement dans la barre du
// bas (dock.slint).

import { Theme, Tr } from "theme.slint";
import { HomeState, AppState } from "state.slint";
import { Icon, PixelLabel, OutlinedText } from "widgets.slint";
import { SkinState, SkinPanel } from "skin.slint";

/// La news affichée : un point, « Nouveautés », son titre et sa date, une flèche. Un clic l'ouvre ;
/// les petites flèches passent à la précédente ou à la suivante.
component PastilleNews inherits Rectangle {
    property <int> n: clamp(HomeState.news-index, 0, max(0, HomeState.news-items.length - 1));
    property <bool> survol: zone.has-hover;
    height: 48px;
    width: contenu.preferred-width;
    border-radius: 8px;
    background: Theme.dark ? #0A0F1DCC : #FFFFFFD9;
    border-width: 1px;
    border-color: root.survol ? Theme.accent.with-alpha(0.7) : Theme.glass-border;
    animate border-color { duration: Theme.fast; }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { HomeState.news-open(root.n); }
    }
    contenu := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            PixelLabel {
                text: Tr.t("Home_News") + (HomeState.news-items[root.n].date != "" ? "  ·  " + HomeState.news-items[root.n].date : "");
                font-size: 11px;
                color: Theme.accent;
            }
            Text {
                text: HomeState.news-items[root.n].title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.navy;
                max-width: 320px;
                overflow: elide;
            }
        }
        // précédente / suivante
        if HomeState.news-items.length > 1: HorizontalLayout {
            spacing: 2px;
            for sens[k] in [-1, 1]: Rectangle {
                width: 30px;
                height: 30px;
                y: 9px;
                border-radius: 6px;
                background: zf.has-hover ? Theme.glass-hover : transparent;
                Icon {
                    text: sens < 0 ? "\u{E76B}" : "\u{E76C}";
                    font-size: 10px;
                    color: Theme.text-muted;
                }
                zf := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        HomeState.news-index = Math.mod(root.n + sens + HomeState.news-items.length, HomeState.news-items.length);
                    }
                }
            }
        }
    }
}

/// Joueurs Mistly en ligne : un point vert qui pulse, « En ligne », le nombre et ceux en jeu.
component PastilleEnLigne inherits Rectangle {
    height: 48px;
    width: contenu.preferred-width;
    border-radius: 8px;
    background: Theme.dark ? #0A0F1DCC : #FFFFFFD9;
    border-width: 1px;
    border-color: Theme.glass-border;
    contenu := HorizontalLayout {
        padding-left: 16px;
        padding-right: 18px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: #1DE062;
                // halo qui pulse doucement
                Rectangle {
                    property <float> t: Math.mod(AppState.temps / 2000ms, 1);
                    width: 8px + 10px * self.t;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: #1DE062;
                    opacity: 0.45 * (1 - self.t);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            PixelLabel {
                text: Tr.t("Home_EnLigne");
                font-size: 11px;
                color: Theme.green-dark;
            }
            Text {
                text: HomeState.online-count + " " + (HomeState.online-count == 1 ? Tr.t("Home_Joueur") : Tr.t("Home_Joueurs"))
                    + (HomeState.online-playing > 0 ? "  ·  " + HomeState.online-playing + " " + Tr.t("Home_EnJeu") : "");
                font-size: 14px;
                font-weight: 700;
                color: Theme.navy;
            }
        }
    }
}

export component HomePage inherits Rectangle {
    // ═══════════ Jouer : le paysage dans un cadre, le logo au milieu ═══════════
    if SkinState.tab == 0: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.glass-border;
        // voile léger en bas : la pastille et le logo restent lisibles sur le paysage
        Rectangle {
            border-radius: 8px;
            background: @linear-gradient(180deg, #00000000 0%, #00000000 55%, (Theme.dark ? #05080F80 : #14203A40) 100%);
        }
        // brume à peine visible qui passe lentement dans le cadre. Découpée à part : dans la même
        // découpe que le logo et la pastille, elle les faisait trembler (la découpe se décalait
        // d'une fraction de pixel avec elle)
        Rectangle {
            border-radius: 8px;
            clip: true;
            for n in [
                { y: 0.18, s: 560, p: 140000, o: 0.10 },
                { y: 0.52, s: 720, p: 180000, o: 0.60 },
                { y: 0.78, s: 620, p: 160000, o: 0.35 },
            ]: Rectangle {
                property <float> t: Math.mod(AppState.temps / (n.p * 1ms) + n.o, 1);
                x: -n.s * 1px + (parent.width + n.s * 2px) * self.t;
                // carrée, le dégradé s'éteint avant les bords, puis aplatie
                y: parent.height * n.y - n.s * 0.5px;
                width: n.s * 1px;
                height: n.s * 1px;
                transform-scale-y: 0.4;
                background: @radial-gradient(circle, #FFFFFF14 0%, #FFFFFF00 65%);
            }
        }
        // le logo, comme celui de Minecraft sur la maquette
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                OutlinedText {
                    text: "PROJET";
                    font-size: min(140px, root.width / 6.5);
                    thickness: 6px;
                    depth: 9px;
                }
            }
            HorizontalLayout {
                alignment: center;
                PixelLabel {
                    text: Tr.t("Home_Badge");
                    font-size: 13px;
                    letter-spacing: 3px;
                    color: Theme.dark ? #DCE6FFCC : #1C2335B3;
                }
            }
        }
        // en bas à gauche : la dernière news, puis les joueurs en ligne
        HorizontalLayout {
            x: 20px;
            y: parent.height - self.height - 20px;
            width: self.preferred-width;
            height: 48px;
            spacing: 10px;
            if HomeState.news-items.length > 0: PastilleNews { }
            if HomeState.online-count >= 0: PastilleEnLigne { }
        }
    }

    // ═══════════ Skin : le studio ═══════════
    if SkinState.tab == 1: SkinPanel { }
}
